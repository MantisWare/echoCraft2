# Local release credentials. Copy to .env.release (gitignored) and fill in
# values. Never commit a populated copy.
#
# Used by: npm run release:mac | release:win | release:linux
# Loaded after .env.signing and .env.upload; process env wins.
# ./upload.sh reads only .env.upload for Nextcloud credentials.

# Nextcloud WebDAV (required for every platform)
NC_URL=https://storage.mantisware.co.za
NC_USER=admin
NC_PASSWORD=
REMOTE_FOLDER=/Public/echocraft/app

# Code signing certificate (.p12 / .pfx). Required for Windows releases.
# macOS local releases ignore CSC_LINK and sign with the Developer ID in the
# login keychain (electron-builder 26.15.3 cannot import CSC_LINK correctly).
CSC_LINK=
CSC_KEY_PASSWORD=
# Optional explicit identity; do not include the "Developer ID Application:" prefix.
# Default in electron-builder.json is Waldo Marais (Z2BVWT9X93)
CSC_NAME=

# macOS notarization — App Store Connect API key (preferred)
APPLE_API_KEY_ID=
APPLE_API_KEY=
APPLE_API_ISSUER=
APPLE_TEAM_ID=Z2BVWT9X93

# macOS notarization — Apple ID fallback
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
