# Better Auth (optional - for account features)
# Self-hosted auth server URL (defaults to https://auth.openwhispr.com)
VITE_AUTH_URL=

# OpenWhispr Cloud API (optional - for cloud transcription)
VITE_OPENWHISPR_API_URL=

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Customize the Whisper model
# Available models: whisper-1 (default), whisper-1-large, whisper-1-large-v2
WHISPER_MODEL=whisper-1

# Optional: Set language for better transcription accuracy
# Leave empty for auto-detection, or use language codes like 'en', 'es', 'fr', etc.
LANGUAGE=

# Optional: UI language for app interface and menus (en, es, fr, de, pt, it)
UI_LANGUAGE=en

# Anthropic API Configuration (optional - for Claude AI processing)
# Get your API key from: https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API Configuration (optional - for Gemini AI processing)
# Get your API key from: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Configuration (optional - for ultra-fast cloud inference)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Tinfoil API Configuration (optional - for private cloud LLM inference)
# Get your API key from: https://tinfoil.sh/inference
TINFOIL_API_KEY=your_tinfoil_api_key_here

# Mistral API Configuration (optional - for Voxtral transcription)
# Get your API key from: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_mistral_api_key_here

# Google Calendar (optional - for calendar sync and meeting detection)
# Create an OAuth client of type "Desktop app" in Google Cloud Console and
# enable the Google Calendar API on the project. Desktop clients allow the
# loopback redirect (http://127.0.0.1:<ephemeral port>) this app uses.
# Scopes: openid, email, calendar.events.readonly, calendar.calendarlist.readonly
# https://console.cloud.google.com/apis/credentials
GOOGLE_CALENDAR_CLIENT_ID=your_google_calendar_client_id_here
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_calendar_client_secret_here

# Microsoft Calendar (optional - for calendar sync and meeting detection)
# Create an Azure app registration with a "Mobile and desktop applications"
# platform and a loopback redirect URI. Registered against the "common" tenant,
# so it covers both work/school and personal accounts. Public client: PKCE only,
# no secret. Delegated permissions: Calendars.Read, User.Read, openid, profile,
# email, offline_access
# https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
MICROSOFT_CALENDAR_CLIENT_ID=your_microsoft_calendar_client_id_here

# Apple Calendar needs no credentials — it reads local EventKit data through
# the bundled macos-calendar-listener helper.

# The three calendar values above are build-time app credentials, not per-user
# keys, and there is no Settings UI for them. Put them in this .env (loaded from
# the repo root in development, from resources/.env in a packaged build), never
# in the userData .env — that file is regenerated from PERSISTED_KEYS on every
# settings save and hand-added lines are dropped.

# Optional: Debug mode
OPENWHISPR_LOG_LEVEL=debug
