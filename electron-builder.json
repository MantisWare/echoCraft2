{
  "appId": "com.mantisware.echocraft",
  "afterPack": "scripts/afterPack.js",
  "productName": "EchoCraft",
  "artifactName": "${productName}-${platform}-${arch}.${ext}",
  "publish": {
    "provider": "generic",
    "url": "https://storage.mantisware.co.za/public.php/dav/files/T9p24tDSSKr5jG7/app/"
  },
  "protocols": {
    "name": "EchoCraft Protocol",
    "schemes": ["echocraft"]
  },
  "directories": {
    "output": "dist"
  },
  "npmRebuild": true,
  "buildDependenciesFromSource": false,
  "files": [
    "main.js",
    "preload.js",
    "package.json",
    "node_modules/**/*",
    "src/dist/**/*",
    "src/helpers/**/*",
    "src/workers/**/*",
    "src/config/**/*",
    "src/constants/**/*",
    "src/locales/**/*",
    "src/hooks/**/*",
    "src/models/**/*",
    "src/services/localReasoningBridge.js",
    "src/services/transcriptionBaseUrl.ts",
    "src/stores/policyRules.ts",
    "src/types/**/*",
    "src/utils.js",
    "src/utils/**/*",
    "src/updater.js",
    "src/components.json",
    "!node_modules/.cache/**/*",
    "!src/node_modules/**/*",

    "!**/node_modules/electron/**",
    "!**/node_modules/electron-builder/**",
    "!**/node_modules/app-builder-bin/**",
    "!**/node_modules/app-builder-lib/**",
    "!**/node_modules/builder-util/**",
    "!**/node_modules/dmg-builder/**",
    "!**/node_modules/7zip-bin/**",

    "!**/node_modules/typescript/**",
    "!**/node_modules/prettier/**",
    "!**/node_modules/eslint/**",
    "!**/node_modules/eslint-*/**",
    "!**/node_modules/@eslint/**",
    "!**/node_modules/@typescript-eslint/**",
    "!**/node_modules/globals/**",

    "!**/node_modules/vite/**",
    "!**/node_modules/@vitejs/**",
    "!**/node_modules/esbuild/**",
    "!**/node_modules/@esbuild/**",
    "!**/node_modules/rollup/**",
    "!**/node_modules/@rollup/**",

    "!**/node_modules/postcss/**",
    "!**/node_modules/autoprefixer/**",
    "!**/node_modules/tailwindcss/**",
    "!**/node_modules/@tailwindcss/**",
    "!**/node_modules/lightningcss*/**",

    "!**/node_modules/react/**",
    "!**/node_modules/react-dom/**",
    "!**/node_modules/lucide-react/**",
    "!**/node_modules/@radix-ui/**",
    "!**/node_modules/class-variance-authority/**",
    "!**/node_modules/clsx/**",
    "!**/node_modules/tailwind-merge/**",
    "!**/node_modules/tw-animate-css/**",
    "!**/node_modules/react-markdown/**",
    "!**/node_modules/shadcn-ui/**",

    "!**/node_modules/@types/**",
    "!**/node_modules/concurrently/**",
    "!**/node_modules/cross-env/**",
    "!**/node_modules/@electron/notarize/**",

    "!**/node_modules/**/test/**",
    "!**/node_modules/**/tests/**",
    "!**/node_modules/**/*.ts",
    "!**/node_modules/**/*.map",
    "!**/node_modules/**/CHANGELOG*",
    "!**/node_modules/**/.github/**"
  ],
  "asarUnpack": [
    "**/node_modules/ffmpeg-static/**/*",
    "**/node_modules/ps-list/**/*",
    "**/node_modules/better-sqlite3/**/*",
    "**/node_modules/onnxruntime-node/**/*",
    "**/node_modules/@napi-rs/keyring/**/*",
    "src/workers/**/*"
  ],
  "extraResources": [
    ".env",
    "src/assets/**/*",
    {
      "from": "resources/bin/",
      "to": "bin/",
      "filter": [
        "whisper-cpp-*",
        "whisper-server-*",
        "llama-server-*",
        "sherpa-onnx-*",
        "yt-dlp-*",
        "qdrant-*",
        "macos-audio-tap",
        "macos-globe-listener",
        "macos-fast-paste",
        "macos-mic-listener",
        "macos-calendar-listener",
        "macos-text-monitor",
        "macos-media-remote",
        "MediaRemoteAdapter.framework/**",
        "linux-fast-paste",
        "linux-system-audio-helper",
        "linux-text-monitor",
        "linux-key-listener*",
        "meeting-aec-helper-*",
        "windows-key-listener*",
        "windows-mic-listener*",
        "windows-system-audio-helper*",
        "windows-text-monitor*",
        "windows-fast-paste*",
        "all-MiniLM-L6-v2/**/*",
        "diarization-models/**/*",
        "whisper-vad/**/*",
        "llama-libs/**/*",
        "*.dylib",
        "*.dll",
        "*.so*"
      ]
    },
    {
      "from": "resources/mediaremote-adapter/bin/mediaremote-adapter.pl",
      "to": "bin/mediaremote-adapter.pl"
    },
    {
      "from": "resources/mediaremote-adapter/LICENSE",
      "to": "bin/mediaremote-adapter.LICENSE"
    }
  ],
  "mac": {
    "category": "public.app-category.productivity",
    "target": ["dmg", "zip"],
    "icon": "src/assets/icon.icns",
    "gatekeeperAssess": false,
    "hardenedRuntime": true,
    "entitlements": "resources/mac/entitlements.mac.plist",
    "entitlementsInherit": "resources/mac/entitlements.mac.plist",
    "identity": "Waldo Marais (Z2BVWT9X93)",
    "notarize": true,
    "extraResources": [{
      "from": "src/assets/Assets.car",
      "to": "Assets.car"
    }],
    "extendInfo": {
      "LSUIElement": false,
      "CFBundleIconName": "echocraft",
      "NSMicrophoneUsageDescription": "EchoCraft uses the microphone to capture your voice for transcription.",
      "NSAudioCaptureUsageDescription": "EchoCraft uses system audio to capture other participants' audio from calls and meetings.",
      "NSAccessibilityUsageDescription": "EchoCraft needs accessibility permissions to paste transcribed text into other applications.",
      "NSCalendarsUsageDescription": "EchoCraft reads your calendar to detect upcoming meetings and link meeting notes to events.",
      "NSCalendarsFullAccessUsageDescription": "EchoCraft reads your calendar to detect upcoming meetings and link meeting notes to events."
    }
  },
  "win": {
    "target": ["nsis", "portable"],
    "icon": "src/assets/icon.ico",
    "verifyUpdateCodeSignature": true,
    "signtoolOptions": {
      "publisherName": "MANTISWARE"
    },
    "extraResources": [{
      "from": "resources/bin/nircmd.exe",
      "to": "bin/nircmd.exe"
    }]
  },
  "linux": {
    "target": [{
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      },
      {
        "target": "rpm",
        "arch": ["x64"]
      },
      {
        "target": "tar.gz",
        "arch": ["x64"]
      }
    ],
    "icon": "src/assets/icon.png",
    "category": "Utility",
    "executableName": "echocraft",
    "synopsis": "AI-powered voice-to-text application",
    "description": "EchoCraft - Voice-to-text transcription with AI assistant",
    "maintainer": "MANTISWARE",
    "vendor": "MANTISWARE",
    "desktop": {
      "entry": {
        "Name": "EchoCraft",
        "Comment": "Voice-to-text transcription with AI",
        "Keywords": "voice;speech;transcription;dictation;ai;whisper"
      }
    }
  },
  "flatpak": {
    "runtime": "org.freedesktop.Platform",
    "runtimeVersion": "24.08",
    "sdk": "org.freedesktop.Sdk",
    "useWaylandFlags": true,
    "finishArgs": [
      "--socket=wayland",
      "--socket=fallback-x11",
      "--share=network",
      "--share=ipc",
      "--device=dri",
      "--socket=pulseaudio",
      "--filesystem=home",
      "--filesystem=xdg-documents",
      "--filesystem=xdg-download",
      "--talk-name=org.freedesktop.Notifications",
      "--talk-name=org.freedesktop.portal.Desktop"
    ]
  },
  "deb": {
    "afterInstall": "resources/linux/after-install.sh",
    "afterRemove": "resources/linux/after-remove.sh",
    "depends": ["ydotool", "libpipewire-0.3-0"],
    "fpm": [
      "--deb-recommends",
      "ydotoold",
      "--deb-suggests",
      "xdotool",
      "--deb-suggests",
      "wtype",
      "--deb-recommends",
      "wl-clipboard",
      "--deb-recommends",
      "xclip",
      "--deb-suggests",
      "xsel"
    ]
  },
  "rpm": {
    "fpm": [
      "--after-install",
      "resources/linux/after-install.sh",
      "--rpm-rpmbuild-define",
      "_build_id_links none",
      "--rpm-tag",
      "Recommends: ydotool",
      "--rpm-tag",
      "Requires: libpipewire-0.3.so.0()(64bit)",
      "--rpm-tag",
      "Suggests: xdotool",
      "--rpm-tag",
      "Suggests: wtype",
      "--rpm-tag",
      "Recommends: wl-clipboard",
      "--rpm-tag",
      "Recommends: xclip",
      "--rpm-tag",
      "Suggests: xsel"
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "EchoCraft",
    "artifactName": "${productName}-${platform}-${arch}.${ext}",
    "include": "resources/nsis/installer.nsh"
  },
  "portable": {
    "artifactName": "${productName}-${platform}-${arch}-portable.${ext}"
  },
  "dmg": {
    "title": "EchoCraft ${version}",
    "icon": "src/assets/icon.icns",
    "window": {
      "width": 540,
      "height": 380
    }
  }
}